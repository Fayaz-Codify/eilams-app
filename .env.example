# Full API base, including /api/v1. See docs/CUSTOMER-APP-API.md in the
# Fayaz-Codify/staynest repository.
#
# Production:
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000/api/v1

# Development against a server on your own machine. A phone cannot reach
# "localhost" — that resolves to the phone. Use your LAN address.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:8000/api/v1
